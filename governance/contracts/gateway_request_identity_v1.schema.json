{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usbay.global/governance/contracts/gateway_request_identity_v1.schema.json",
  "title": "USBAY Gateway Request Identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canonicalization",
    "identity_reference",
    "tenant_reference",
    "environment_reference",
    "subject_reference",
    "issuer_id",
    "audience",
    "purpose",
    "environment",
    "http_method",
    "request_path",
    "request_id",
    "correlation_id",
    "nonce",
    "valid_from",
    "valid_until",
    "request_body_hash",
    "signature_alg",
    "pubkey_id",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "usbay.gateway.request_identity.v1"},
    "canonicalization": {"const": "usbay.canonical_json.v1"},
    "identity_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "tenant_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "subject_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issuer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "audience": {"type": "string", "minLength": 1, "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 128},
    "environment": {"type": "string", "minLength": 1, "maxLength": 128},
    "http_method": {"type": "string", "pattern": "^[A-Z]+$"},
    "request_path": {"type": "string", "pattern": "^/"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "nonce": {"type": "string", "minLength": 1, "maxLength": 128},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "request_body_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature_alg": {"const": "ed25519"},
    "pubkey_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "signature": {"type": "string", "minLength": 1}
  }
}
