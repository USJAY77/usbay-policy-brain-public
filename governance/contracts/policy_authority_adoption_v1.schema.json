{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usbay.policy_authority_adoption.v1",
  "title": "Tenant-bound policy authority adoption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "adoption_id", "scope_key", "policy_id", "policy_hash",
    "policy_version", "tenant_reference", "environment_reference", "environment",
    "approval_bundle_hashes", "approval_nonce_hashes", "approver_ids",
    "approver_identity_references", "approver_key_fingerprints",
    "approver_registry_hash", "approver_registry_version", "registry_evidence_hash",
    "revocation_state_reference", "valid_from", "valid_until", "status",
    "authority_state_reference", "record_hash", "execution_authorized",
    "provider_authorized", "deployment_authorized", "activation_authorized",
    "policy_authoring_authorized"
  ],
  "properties": {
    "schema_version": {"const": "usbay.policy_authority_adoption.v1"},
    "adoption_id": {"$ref": "#/$defs/hashReference"},
    "scope_key": {"$ref": "#/$defs/hashReference"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_hash": {"$ref": "#/$defs/hashReference"},
    "policy_version": {"type": "string", "minLength": 1},
    "tenant_reference": {"$ref": "#/$defs/hashReference"},
    "environment_reference": {"$ref": "#/$defs/hashReference"},
    "environment": {"type": "string", "enum": ["development", "test", "staging", "production"]},
    "approval_bundle_hashes": {"$ref": "#/$defs/hashPair"},
    "approval_nonce_hashes": {"$ref": "#/$defs/hexPair"},
    "approver_ids": {"$ref": "#/$defs/stringPair"},
    "approver_identity_references": {"$ref": "#/$defs/hashPair"},
    "approver_key_fingerprints": {"$ref": "#/$defs/hexPair"},
    "approver_registry_hash": {"$ref": "#/$defs/hashReference"},
    "approver_registry_version": {"type": "string", "minLength": 1},
    "registry_evidence_hash": {"$ref": "#/$defs/hashReference"},
    "revocation_state_reference": {"$ref": "#/$defs/hashReference"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "status": {"const": "ADOPTED"},
    "authority_state_reference": {"$ref": "#/$defs/hashReference"},
    "record_hash": {"$ref": "#/$defs/hashReference"},
    "execution_authorized": {"const": false},
    "provider_authorized": {"const": false},
    "deployment_authorized": {"const": false},
    "activation_authorized": {"const": false},
    "policy_authoring_authorized": {"const": false}
  },
  "$defs": {
    "hashReference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hashPair": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/hashReference"}},
    "hexPair": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "stringPair": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
