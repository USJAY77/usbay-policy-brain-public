{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usbay.global/governance/evidence/euria_customer_onboarding_bridge_v1_schema.json",
  "title": "USBAY EURIA Customer Onboarding Bridge Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "tenant_reference",
    "environment_reference",
    "policy_reference",
    "state",
    "reason_codes",
    "timestamp",
    "contract_hash",
    "evidence_hash"
  ],
  "properties": {
    "contract_version": {
      "const": "usbay.euria.customer_onboarding_bridge.v1"
    },
    "request_id": {
      "type": "string"
    },
    "tenant_reference": {
      "type": "string"
    },
    "environment_reference": {
      "type": "string"
    },
    "policy_reference": {
      "type": "string"
    },
    "state": {
      "enum": [
        "INTAKE_RECEIVED",
        "REVIEW_REQUIRED",
        "HUMAN_APPROVED",
        "POLICY_VALIDATED",
        "ONBOARDING_PENDING",
        "IDENTITY_PENDING",
        "VERIFIER_PENDING",
        "ATTESTATION_PENDING",
        "PILOT_READY",
        "BLOCKED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "contract_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
