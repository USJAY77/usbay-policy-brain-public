{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://usbay.example/schemas/dependency-artifact-provenance-v1.json",
  "title": "USBAY dependency artifact provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "record_id", "package", "artifact", "platform", "source",
    "build", "attestation", "transparency", "witnesses", "approvals",
    "lineage", "record_hash"
  ],
  "properties": {
    "schema": {"const": "usbay.dependency_artifact_evidence.v1"},
    "record_id": {"type": "string", "minLength": 1},
    "package": {"$ref": "#/$defs/package"},
    "artifact": {"$ref": "#/$defs/artifact"},
    "platform": {"$ref": "#/$defs/platform"},
    "source": {"$ref": "#/$defs/source"},
    "build": {"$ref": "#/$defs/build"},
    "attestation": {"$ref": "#/$defs/attestation"},
    "transparency": {"$ref": "#/$defs/transparency"},
    "witnesses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/witness"}},
    "approvals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/approval"}},
    "lineage": {"$ref": "#/$defs/lineage"},
    "record_hash": {"$ref": "#/$defs/sha256ref"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["normalized_project_name", "index_project_identity", "version"],
      "properties": {
        "normalized_project_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "index_project_identity": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "sha256", "size"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["os", "architecture", "python_implementation", "python_version", "python_tag", "abi_tag", "wheel_platform_tag"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_implementation": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "minLength": 1},
        "python_tag": {"type": "string", "minLength": 1},
        "abi_tag": {"type": "string", "minLength": 1},
        "wheel_platform_tag": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["upstream_repository", "release_tag", "source_commit_sha"],
      "properties": {
        "upstream_repository": {"type": "string", "minLength": 1},
        "release_tag": {"type": "string", "minLength": 1},
        "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_identity", "workflow_definition_sha256", "workflow_run_id", "workflow_job_id", "builder_identity"],
      "properties": {
        "workflow_identity": {"type": "string", "minLength": 1},
        "workflow_definition_sha256": {"$ref": "#/$defs/sha256"},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "workflow_job_id": {"type": "string", "minLength": 1},
        "builder_identity": {"type": "string", "minLength": 1}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["predicate_type", "subject_name", "subject_sha256", "signature", "certificate_or_key_fingerprint", "signer_identity", "issuer_identity", "issued_at", "expires_at"],
      "properties": {
        "predicate_type": {"type": "string", "minLength": 1},
        "subject_name": {"type": "string", "minLength": 1},
        "subject_sha256": {"$ref": "#/$defs/sha256"},
        "signature": {"type": "string", "minLength": 1},
        "certificate_or_key_fingerprint": {"$ref": "#/$defs/sha256ref"},
        "signer_identity": {"type": "string", "minLength": 1},
        "issuer_identity": {"type": "string", "minLength": 1},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "transparency": {
      "type": "object", "additionalProperties": false,
      "required": ["log_id", "entry_identifier", "integrated_time", "inclusion_proof_hash", "signed_checkpoint", "checkpoint_identity", "checkpoint_time"],
      "properties": {
        "log_id": {"type": "string", "minLength": 1},
        "entry_identifier": {"type": "string", "minLength": 1},
        "integrated_time": {"$ref": "#/$defs/timestamp"},
        "inclusion_proof_hash": {"$ref": "#/$defs/sha256ref"},
        "signed_checkpoint": {"type": "string", "minLength": 1},
        "checkpoint_identity": {"type": "string", "minLength": 1},
        "checkpoint_time": {"$ref": "#/$defs/timestamp"}
      }
    },
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["witness_id", "state", "acquisition_channel", "operator_domain", "evidence_sha256", "independence_state"],
      "properties": {
        "witness_id": {"type": "string", "minLength": 1},
        "state": {"const": "PROVEN"},
        "acquisition_channel": {"type": "string", "minLength": 1},
        "operator_domain": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256ref"},
        "independence_state": {"const": "PROVEN"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "actor_type", "actor_id", "actor_role", "device_id", "timestamp", "policy_version", "approval_evidence_sha256"],
      "properties": {
        "decision": {"const": "APPROVE"},
        "actor_type": {"const": "human"},
        "actor_id": {"type": "string", "minLength": 1},
        "actor_role": {"type": "string", "minLength": 1},
        "device_id": {"type": "string", "minLength": 1},
        "timestamp": {"$ref": "#/$defs/timestamp"},
        "policy_version": {"type": "string", "minLength": 1},
        "approval_evidence_sha256": {"$ref": "#/$defs/sha256ref"}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "previous_record_hash", "supersedes_record_id", "effective_at", "expires_at"],
      "properties": {
        "generation": {"type": "integer", "minimum": 1},
        "previous_record_hash": {"$ref": "#/$defs/sha256ref"},
        "supersedes_record_id": {"type": ["string", "null"]},
        "effective_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
