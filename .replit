entrypoint = "gateway/app.py"
modules = ["python-3.11"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", ": \"${PORT:?PORT is required for USBAY gateway deployment}\" && cd .runtime-artifact && export USBAY_ENV=production && exec python3 -B -m uvicorn gateway.app:app --host 0.0.0.0 --port \"$PORT\""]
build = ["sh", "-c", "python3 -m security.runtime_artifact_package --source . --destination .runtime-artifact --signing-key-file \"${USBAY_RUNTIME_ARTIFACT_BUILD_KEY_FILE:?explicit external producer signing key file required}\" --producer-key-id \"${USBAY_RUNTIME_ARTIFACT_PRODUCER_KEY_ID:?producer key ID required}\" --producer-scope production"]

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3.11 -m uvicorn gateway.app:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
