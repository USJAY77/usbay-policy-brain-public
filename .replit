entrypoint = "gateway/app.py"
modules = ["python-3.11"]

[agent]
expertMode = true

[nix]
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", ": \"${PORT:?PORT is required for USBAY gateway deployment}\" && exec python3 -m uvicorn gateway.app:app --host 0.0.0.0 --port \"$PORT\""]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8765
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "USBAY Gateway"

[[workflows.workflow]]
name = "USBAY Gateway"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 -m uvicorn gateway.app:app --host 0.0.0.0 --port 5000"
waitForPort = 5000
