entrypoint = "gateway/app.py"
modules = ["python-3.11", "nodejs-22"]

[agent]
expertMode = true

[nix]
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", ": \"${PORT:?PORT is required for USBAY gateway deployment}\" && exec python3 -m uvicorn gateway.app:app --host 0.0.0.0 --port \"$PORT\""]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8765
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "USBAY Gateway"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "game-stability"

[[workflows.workflow]]
name = "USBAY Gateway"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/preview_port_forward.py & PORT=5000 python3 -m uvicorn gateway.app:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "game-stability"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3.11 scripts/game_stability_gate.py"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
