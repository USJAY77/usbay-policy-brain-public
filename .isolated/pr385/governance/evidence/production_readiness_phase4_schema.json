{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usbay.production_readiness.phase4.authorization_boundary.v1",
  "title": "USBAY Production Readiness Phase 4 Authorization Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "schema_version",
    "policy_id",
    "policy_version",
    "policy_digest",
    "evidence_manifest_digest",
    "source_commit_sha",
    "source_branch",
    "environment_class",
    "requested_action_type",
    "requested_target",
    "parameters_digest",
    "requester_identity_reference",
    "approver_identity_references",
    "approval_policy_reference",
    "required_approval_count",
    "recorded_approval_count",
    "approval_quorum_satisfied",
    "authorized_approver_identity_references",
    "revoked_approver_identity_references",
    "self_approval_prohibited",
    "approval_issued_at",
    "approval_expires_at",
    "approval_evidence_digest",
    "signer_identity_reference",
    "allowed_signer_identity_references",
    "signature_algorithm",
    "signature_reference",
    "signature_verified",
    "trust_root_reference",
    "trusted_root_references",
    "trust_root_verified",
    "timestamp_reference",
    "timestamp_verified",
    "evidence_freshness_seconds",
    "evidence_not_before",
    "evidence_expires_at",
    "evidence_fresh",
    "anti_replay_reference",
    "used_anti_replay_references",
    "replay_check_passed",
    "anti_rollback_reference",
    "rollback_check_passed",
    "minimum_policy_version",
    "change_ticket_reference",
    "rollback_plan_reference",
    "capabilities",
    "action_contract"
  ],
  "properties": {
    "phase": {"const": "phase4"},
    "schema_version": {"const": "usbay.production_readiness.phase4.authorization_boundary.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"const": "usbay.production-readiness.phase4.v1"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_branch": {"type": "string", "minLength": 1},
    "environment_class": {"enum": ["internal_controlled", "limited_pilot", "enterprise_production"]},
    "requested_action_type": {"const": "production_readiness_boundary"},
    "requested_target": {"type": "string", "minLength": 1},
    "parameters_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requester_identity_reference": {"type": "string", "minLength": 1},
    "approver_identity_references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "approval_policy_reference": {"type": "string", "minLength": 1},
    "required_approval_count": {"type": "integer", "minimum": 1},
    "recorded_approval_count": {"type": "integer", "minimum": 0},
    "approval_quorum_satisfied": {"type": "boolean"},
    "authorized_approver_identity_references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "revoked_approver_identity_references": {"type": "array", "items": {"type": "string"}},
    "self_approval_prohibited": {"type": "boolean"},
    "approval_issued_at": {"type": "string"},
    "approval_expires_at": {"type": "string"},
    "approval_evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer_identity_reference": {"type": "string", "minLength": 1},
    "allowed_signer_identity_references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "signature_algorithm": {"const": "TEST_DETERMINISTIC_SHA256"},
    "signature_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature_verified": {"type": "boolean"},
    "trust_root_reference": {"type": "string", "minLength": 1},
    "trusted_root_references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "trust_root_verified": {"type": "boolean"},
    "timestamp_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp_verified": {"type": "boolean"},
    "evidence_freshness_seconds": {"type": "integer", "minimum": 1},
    "evidence_not_before": {"type": "string"},
    "evidence_expires_at": {"type": "string"},
    "evidence_fresh": {"type": "boolean"},
    "anti_replay_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "used_anti_replay_references": {"type": "array", "items": {"type": "string"}},
    "replay_check_passed": {"type": "boolean"},
    "anti_rollback_reference": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rollback_check_passed": {"type": "boolean"},
    "minimum_policy_version": {"const": "usbay.production-readiness.phase4.v1"},
    "change_ticket_reference": {"type": "string", "minLength": 1},
    "rollback_plan_reference": {"type": "string", "minLength": 1},
    "capabilities": {"type": "object"},
    "action_contract": {"type": "object"},
    "execution_allowed": {"const": false},
    "provider_execution": {"const": false},
    "production_activation": {"const": false},
    "deployment_authorized": {"const": false},
    "release_authorized": {"const": false},
    "production_boundary_ready": {"type": "boolean"},
    "decision": {"enum": ["READY_METADATA_ONLY", "EXTERNAL_TRUST_EVIDENCE_VERIFIED", "BLOCKED", "INVALID"]},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
